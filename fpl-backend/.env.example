# MongoDB Atlas (include database name in the path). Example:
# DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fpl?retryWrites=true&w=majority
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fpl?retryWrites=true&w=majority
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
SUPABASE_URL=https://bdxgtxevzffcvlcdfcmg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
PORT=3000
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
ENABLE_INGESTION_CRON=true
INGESTION_CRON_BOOTSTRAP=0 3 * * *
INGESTION_CRON_STATS=*/30 * * * *
ENABLE_SCORING_CRON=true
SCORING_CRON_SCHEDULE=*/15 * * * *
ENABLE_BULLMQ=true
ENABLE_SOCKET_IO=true
LIVE_STATS_POLL_CRON=*/2 * * * *
PRICE_CHANGE_CRON=0 2 * * *
DEADLINE_REMINDER_CRON=*/15 * * * *
DEADLINE_REMINDER_MINUTES=60,1440
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://localhost:5176
CACHE_ENABLED=true
CACHE_TTL_PLAYERS_SECONDS=600
CACHE_TTL_FIXTURES_SECONDS=600
CACHE_TTL_STANDINGS_SECONDS=300
CACHE_TTL_STANDINGS_LIVE_SECONDS=30
CACHE_TTL_ANALYTICS_GROWTH_SECONDS=120
ALERT_QUEUE_FAILED_THRESHOLD=5
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_ERROR_RATE_WINDOW_MINUTES=15
ALERT_COOLDOWN_SECONDS=3600
# Staked leagues / finance
FINANCE_CURRENCY=ETB
MAX_STAKE_MINOR=1000000
MAX_POT_MINOR=50000000
PLATFORM_COMMISSION_BPS=1000
PAYMENT_PROVIDER=mock
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_ALERTS_ENABLED=false
# Server-only BotFather token. Never use this value in VITE_* variables or client code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEBIRR_ENABLED=false
TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_PUBLIC_KEY=
ADVANCED_MATCH_DATA_ENABLED=false
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
FINANCE_TERMS_VERSION=1.0
RECONCILIATION_CRON=0 */6 * * *
FRAUD_DETECTION_CRON=0 4 * * *
SUPPORT_CONTACT_EMAIL=support@example.com
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
TERMS_URL=https://example.com/terms

# Integration tests. TEST_DATABASE_URL must target an Atlas database named
# fpl_test* or fpl_ci*, and TEST_REDIS_URL must be remote.
TEST_DATABASE_URL=
TEST_REDIS_URL=

# Maintenance and migration scripts. Keep destructive confirmations false/blank
# until following the corresponding runbook.
SEED_DEV_ADMIN=false
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
BACKUP_VERIFIED=false
MIGRATION_VALIDATED=false
CONFIRM_SCRUB=

