{
  "name": "fpl-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate:auth": "ts-node scripts/migrateAuthToSupabase.ts",
    "migrate:auth:confirmed": "cross-env BACKUP_VERIFIED=true ts-node scripts/migrateAuthToSupabase.ts",
    "migrate:scrub-credentials": "ts-node scripts/scrubLegacyCredentials.ts",
    "telegram:set-webhook": "ts-node scripts/setTelegramWebhook.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "ingest": "ts-node src/scripts/ingest.ts",
    "seed": "prisma db seed",
    "seed:admin": "ts-node prisma/runSeedAdmin.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --config jest.unit.config.js --runInBand --detectOpenHandles",
    "test:integration": "jest --config jest.integration.config.js --runInBand --detectOpenHandles",
    "test:coverage": "jest --runInBand --coverage",
    "load:test": "k6 run load-tests/squad-save.js",
    "load:test:transfers": "k6 run load-tests/transfers.js",
    "load:test:live": "k6 run load-tests/live-fanout.js",
    "load:test:smoke": "k6 run --vus 2 --duration 10s load-tests/squad-save.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.0",
    "@bull-board/express": "^8.1.0",
    "@prisma/client": "6.9.0",
    "@supabase/supabase-js": "2.110.8",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "grammy": "^1.45.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "libphonenumber-js": "^1.13.10",
    "mongodb": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "pino": "^9.7.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.32",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "6.9.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
