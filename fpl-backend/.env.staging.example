# Staging environment — copy to .env.staging locally or set in host secret manager.
# Use a dedicated MongoDB Atlas database/cluster for staging.

NODE_ENV=production
APP_ENV=staging
LOG_LEVEL=info
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/fpl_staging?retryWrites=true&w=majority

REDIS_URL=rediss://default:PASSWORD@staging-key-value:PORT
SUPABASE_URL=https://bdxgtxevzffcvlcdfcmg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

PORT=3000
FPL_API_BASE_URL=https://fantasy.premierleague.com/api

# Staging: enable crons only if you want live ingestion against staging DB
ENABLE_INGESTION_CRON=false
ENABLE_SCORING_CRON=false
ENABLE_BULLMQ=true
ENABLE_SOCKET_IO=true

CORS_ORIGIN=https://staging-admin.example.com,https://staging-app.example.com
FRONTEND_URL=https://staging-app.example.com
PUBLIC_API_URL=https://staging-api.example.com

CACHE_ENABLED=true
CACHE_TTL_PLAYERS_SECONDS=600
CACHE_TTL_FIXTURES_SECONDS=600
CACHE_TTL_STANDINGS_SECONDS=300
CACHE_TTL_STANDINGS_LIVE_SECONDS=30

# Telegram Mini App authentication. The bot token is server-only.
TELEGRAM_AUTH_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=

# Mock payments are allowed in staging, but hosted-runtime safeguards still
# require a unique webhook secret and a real support contact.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SUPPORT_CONTACT_EMAIL=support@example.org
TELEBIRR_ENABLED=false

# Do not seed dev admin in shared staging unless intentional
SEED_DEV_ADMIN=false
