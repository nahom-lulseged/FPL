{
  "name": "fpl-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lighthouse": "npm run build && vite preview --port 4173",
    "lighthouse:audit": "npx lighthouse http://localhost:4173/telegram-auth --only-categories=performance,accessibility --chrome-flags=\"--headless\" --output=html --output-path=./lighthouse-report.html"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.6.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "soccer-jersey-fixed": "^1.0.15",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  }
}
